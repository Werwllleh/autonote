generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  avatar    String?
  role          UserRole @default(USER)
  emailVerified Boolean  @default(false) @map("email_verified")
  verifyToken   String?  @unique @map("verify_token")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  lastLoginAt                DateTime? @map("last_login_at")
  lastVerificationReminderAt DateTime? @map("last_verification_reminder_at")
  verificationReminderCount  Int       @default(0) @map("verification_reminder_count")
  lastExpenseReminderAt      DateTime? @map("last_expense_reminder_at")
  expenseReminderCount       Int       @default(0) @map("expense_reminder_count")
  expenseRemindersEnabled    Boolean   @default(true) @map("expense_reminders_enabled")

  vehicles   Vehicle[]
  categories Category[]

  @@map("users")
}

model Vehicle {
  id      String @id @default(uuid())
  brand   String
  model   String
  year    Int
  mileage        Int @default(0)
  initialMileage Int @default(0) @map("initial_mileage")
  photo          String?

  vin                String?   @map("vin")
  licensePlate       String?   @map("license_plate")
  registrationNumber String?   @map("registration_number")
  purchaseDate       DateTime? @map("purchase_date")
  purchasePrice      Float?    @map("purchase_price")
  notes              String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expenses         Expense[]
  parts            Part[]
  serviceIntervals ServiceInterval[]
  publicReports    PublicReport[]

  @@map("vehicles")
}

model PublicReport {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  vehicleId String  @map("vehicle_id")
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("public_reports")
}

model Category {
  id     String  @id @default(uuid())
  name   String
  slug   String
  isSystem Boolean @default(false) @map("is_system")

  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expenses Expense[]

  @@unique([slug, userId])
  @@map("categories")
}

model Part {
  id        String   @id @default(uuid())
  name      String
  article   String?
  quantity  Int      @default(0)
  price     Float    @default(0)
  location  String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  vehicleId String  @map("vehicle_id")
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("parts")
}

model Expense {
  id          String   @id @default(uuid())
  amount      Float
  date        DateTime
  description String?
  mileage     Int?

  liters        Float? @map("liters")
  pricePerLiter Float? @map("price_per_liter")
  bonuses       Float? @map("bonuses")

  parts     Json?  @map("parts")
  laborCost Float? @map("labor_cost")

  dateFrom DateTime? @map("date_from")
  dateTo   DateTime? @map("date_to")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  vehicleId  String   @map("vehicle_id")
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  categoryId String   @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id])

  @@map("expenses")
}

model ServiceInterval {
  id             String @id @default(uuid())
  name           String
  intervalKm     Int?   @map("interval_km")
  intervalMonths Int?   @map("interval_months")

  lastServiceDate    DateTime? @map("last_service_date")
  lastServiceMileage Int?      @map("last_service_mileage")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  vehicleId String  @map("vehicle_id")
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("service_intervals")
}
