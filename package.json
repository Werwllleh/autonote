{
  "name": "autonote",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:client": "npm run dev -w apps/client",
    "dev:server": "npm run start:dev -w apps/server",
    "build:client": "npm run build -w apps/client",
    "build:server": "npm run build -w apps/server",
    "lint": "npm run lint -w apps/client && npm run lint -w apps/server",
    "db:migrate": "cd apps/server && npx prisma migrate dev",
    "db:generate": "cd apps/server && npx prisma generate",
    "db:studio": "cd apps/server && npx prisma studio"
  }
}
